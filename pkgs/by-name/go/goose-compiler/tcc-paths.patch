diff --git a/CMakeLists.txt b/CMakeLists.txt
index eaa36831..383cd8aa 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -133,7 +133,12 @@ target_link_libraries(goose PRIVATE goose_shaderc)
 include(cmake/libtcc.cmake)
 target_link_libraries(goose PRIVATE libtcc)
 add_dependencies(goose tcc_runtime)
-target_compile_definitions(goose PRIVATE GOOSE_TCC_LIB_PATH="${TCC_STAGE}")
+# Where the compiler looks for TinyCC's runtime when none is beside it: the
+# build tree's staged copy, or where a packager installs it, so that the
+# binary names no build directory.
+set(GOOSE_TCC_LIB_PATH "${TCC_STAGE}" CACHE PATH
+    "TinyCC's runtime directory, when there is no tcclib/ beside the compiler")
+target_compile_definitions(goose PRIVATE GOOSE_TCC_LIB_PATH="${GOOSE_TCC_LIB_PATH}")
 
 # The blessed packages GOOSE_BUILTIN_LIBS names (src/blessed.txt; `all`, or
 # a list of their names), compiled into the compiler (cmake/package.cmake),
diff --git a/cmake/libtcc.cmake b/cmake/libtcc.cmake
index 2f4940e3..bee6ae2b 100644
--- a/cmake/libtcc.cmake
+++ b/cmake/libtcc.cmake
@@ -86,6 +86,22 @@ if(APPLE)
     string(APPEND tcc_config
         "#define CONFIG_TCC_SYSINCLUDEPATHS \"{B}/include:${tcc_sdk}/usr/include\"\n")
 endif()
+# Where the C library is not where the defaults above look (a Nix or Guix
+# store, a sysroot), a packager names its directories instead. Each one set
+# replaces what the platform blocks above chose; TinyCC substitutes {B} with
+# the staged directory.
+set(GOOSE_TCC_SYSINCLUDEPATHS "" CACHE STRING
+    "TinyCC's system include path, ':'-separated (default: the platform's)")
+set(GOOSE_TCC_LIBPATHS "" CACHE STRING
+    "TinyCC's library path, ':'-separated, {B} first (default: the platform's)")
+set(GOOSE_TCC_CRTPREFIX "" CACHE STRING
+    "The directory of the C library's crt*.o (default: the platform's)")
+foreach(opt IN ITEMS SYSINCLUDEPATHS LIBPATHS CRTPREFIX)
+    if(GOOSE_TCC_${opt})
+        string(APPEND tcc_config
+            "#undef CONFIG_TCC_${opt}\n#define CONFIG_TCC_${opt} \"${GOOSE_TCC_${opt}}\"\n")
+    endif()
+endforeach()
 # Written only when it changes, so reconfiguring does not rebuild TinyCC.
 file(CONFIGURE OUTPUT "${TCC_BUILD}/config.h" CONTENT "${tcc_config}" @ONLY)
 
