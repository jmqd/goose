diff --git a/CMakeLists.txt b/CMakeLists.txt
index eaa36831..f8be033e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -133,7 +133,10 @@ target_link_libraries(goose PRIVATE goose_shaderc)
 include(cmake/libtcc.cmake)
 target_link_libraries(goose PRIVATE libtcc)
 add_dependencies(goose tcc_runtime)
-target_compile_definitions(goose PRIVATE GOOSE_TCC_LIB_PATH="${TCC_STAGE}")
+# A packager sets this to where it installs tcclib/, so the binary names no
+# build directory. A tcclib/ beside the compiler still wins (src/jit.h).
+set(GOOSE_TCC_LIB_PATH "${TCC_STAGE}" CACHE PATH "TinyCC's runtime directory")
+target_compile_definitions(goose PRIVATE GOOSE_TCC_LIB_PATH="${GOOSE_TCC_LIB_PATH}")
 
 # The blessed packages GOOSE_BUILTIN_LIBS names (src/blessed.txt; `all`, or
 # a list of their names), compiled into the compiler (cmake/package.cmake),
diff --git a/cmake/libtcc.cmake b/cmake/libtcc.cmake
index 2f4940e3..389b5cd1 100644
--- a/cmake/libtcc.cmake
+++ b/cmake/libtcc.cmake
@@ -86,6 +86,16 @@ if(APPLE)
     string(APPEND tcc_config
         "#define CONFIG_TCC_SYSINCLUDEPATHS \"{B}/include:${tcc_sdk}/usr/include\"\n")
 endif()
+# For a C library outside the paths above, as in a Nix store: each one set
+# replaces the platform's value. {B} is the staged directory.
+set(GOOSE_TCC_SYSINCLUDEPATHS "" CACHE STRING "TinyCC's include path, ':'-separated")
+set(GOOSE_TCC_LIBPATHS "" CACHE STRING "TinyCC's library path, ':'-separated, {B} first")
+foreach(opt IN ITEMS SYSINCLUDEPATHS LIBPATHS)
+    if(GOOSE_TCC_${opt})
+        string(APPEND tcc_config
+            "#undef CONFIG_TCC_${opt}\n#define CONFIG_TCC_${opt} \"${GOOSE_TCC_${opt}}\"\n")
+    endif()
+endforeach()
 # Written only when it changes, so reconfiguring does not rebuild TinyCC.
 file(CONFIGURE OUTPUT "${TCC_BUILD}/config.h" CONTENT "${tcc_config}" @ONLY)
 
